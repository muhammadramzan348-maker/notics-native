{
  "expo": {
    "name": "NOCTIS",
    "slug": "noctis",
    "scheme": "noctis",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090B",
    "android": {
      "package": "com.noctis.app",
      "permissions": ["POST_NOTIFICATIONS", "SCHEDULE_EXACT_ALARM"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      ["expo-notifications", { "color": "#06B6D4" }]
    ]
  }
}
